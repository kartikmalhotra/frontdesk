# Required for the live agent. Not needed for tests.
ANTHROPIC_API_KEY=

# Model to use. Any current Claude model works.
MODEL=claude-sonnet-5-5

# fake = built-in demo calendar (default). google = real Google Calendar.
CALENDAR_BACKEND=fake
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# Where leads and bookings are stored.
DATABASE_PATH=frontdesk.db

# Which business file to load.
BUSINESS_FILE=business.yaml

# Simple password for /admin. Change it.
ADMIN_PASSWORD=change-me
